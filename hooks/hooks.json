{
  "description": "agent-builder plan guard: while an agent plan is being drafted, blocks file writes (except the plan file) and state-changing shell commands, and holds each question round until the ledger is updated. Inactive otherwise.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/agent-builder/scripts/plan_guard.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/agent-builder/scripts/plan_guard.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/agent-builder/scripts/plan_guard.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
